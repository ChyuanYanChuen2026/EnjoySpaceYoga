@model EnjoySpace.Web.Areas.Admin.ViewModels.PagedRecords<EnjoySpace.Web.Models.Entities.LessonPass>
@using EnjoySpace.Web.Models
@{ ViewData["Title"] = "方案購買紀錄"; }
<h1 class="h3">方案購買紀錄</h1><a asp-action="Create" class="btn btn-primary mb-3">購買方案</a>
<div class="table-responsive card card-body"><table sort-set="passes" class="table align-middle"><thead><tr><th sort-key="name">購買對象</th><th sort-key="plan">購買時方案</th><th sort-key="price">堂數／金額</th><th sort-key="date">效期</th><th sort-key="payment">付款</th><th>操作</th></tr></thead><tbody>
@foreach (var p in Model.Items) {
    <tr><td>@(p.TrialGuest?.Name ?? p.Student?.User.DisplayName)</td><td>@p.PlanNameAtPurchase</td><td>@p.SessionQuotaAtPurchase 堂／$@p.AmountAtPurchase.ToString("N2")</td>
        <td>@p.ValidFromDate.ToString("yyyy/MM/dd") ～ @(p.ValidUntilDate?.ToString("yyyy/MM/dd") ?? "不限期")</td><td>@WorkflowLabels.Payment(p.Payment.Status)</td>
        <td><a asp-action="Details" asp-route-id="@p.LessonPassId">詳細／收款</a></td></tr>
}</tbody></table>@if (Model.TotalCount == 0) { <p>目前沒有方案購買紀錄。</p> }</div>
<p class="mt-3">共 @Model.TotalCount 筆，第 @Model.Page / @Model.PageCount 頁</p>
@if (Model.Page > 1) { <a asp-action="Index" asp-route-sort="@Context.Request.Query["Sort"]" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">上一頁</a> }
@if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-sort="@Context.Request.Query["Sort"]" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">下一頁</a> }
