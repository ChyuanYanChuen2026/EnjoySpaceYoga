@model EnjoySpace.Web.Models.Entities.LessonPass
@using EnjoySpace.Web.Models
@{ ViewData["Title"] = "方案購買詳細"; var today = (DateOnly)ViewData["Today"]!; }
<h1 class="h3">方案購買詳細</h1>


<div class="card card-body mb-3"><dl class="row mb-0">
    <dt class="col-sm-3">購買對象</dt><dd class="col-sm-9">@(Model.TrialGuest?.Name ?? Model.Student?.User.DisplayName)</dd>
    <dt class="col-sm-3">購買時方案</dt><dd class="col-sm-9">@Model.PlanNameAtPurchase · @Model.SessionQuotaAtPurchase 堂</dd>
    <dt class="col-sm-3">應收金額</dt><dd class="col-sm-9">$@Model.AmountAtPurchase.ToString("N0")</dd>
    <dt class="col-sm-3">效期</dt><dd class="col-sm-9">@Model.ValidFromDate.ToString("yyyy/MM/dd") ～ @(Model.ValidUntilDate?.ToString("yyyy/MM/dd") ?? "不限期")（含起訖日）</dd>
    <dt class="col-sm-3">付款</dt><dd class="col-sm-9">@WorkflowLabels.Payment(Model.Payment.Status)</dd>
    <dt class="col-sm-3">堂券狀態</dt><dd class="col-sm-9">@(Model.Status == "Pending" ? "待付款，尚未啟用" : Model.Status == "Cancelled" ? "已取消" : Model.ValidUntilDate < today ? "已過期" : Model.ValidFromDate > today ? "已啟用，尚未到生效日" : "已啟用")</dd>
    @if (Model.Payment.PaidAtUtc.HasValue) { <dt class="col-sm-3">付款時間（台灣）</dt><dd class="col-sm-9">@Model.Payment.PaidAtUtc.Value.AddHours(8).ToString("yyyy/MM/dd HH:mm")</dd> }
    @if (!string.IsNullOrEmpty(Model.Payment.Note)) { <dt class="col-sm-3">收款備註</dt><dd class="col-sm-9">@Model.Payment.Note</dd> }
    @if (!string.IsNullOrEmpty(Model.Note)) { <dt class="col-sm-3">訂單備註</dt><dd class="col-sm-9">@Model.Note</dd> }
</dl></div>
@if (Model.Status == "Pending" && Model.Payment.Status == "Pending")
{
    if (User.IsInRole("Admin")) { <form asp-action="ConfirmPayment" method="post" class="card card-body mb-3">
        <h2 class="h5">確認收款並啟用</h2>
        <input name="Id" type="hidden" value="@Model.LessonPassId" /><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)" />
        <div class="row g-3">
            <div class="col-md-4"><label for="ReceivedAmount" class="form-label">實收金額</label><input name="ReceivedAmount" id="ReceivedAmount" type="number" min="0" step="0.01" value="@Model.AmountAtPurchase.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required /></div>
            <div class="col-md-4"><label for="Method" class="form-label">付款方式</label><select name="Method" id="Method" class="form-select"><option value="Cash">現金</option><option value="Transfer">轉帳</option><option value="LinePay">Line Pay</option></select></div>
            <div class="col-md-4"><label for="PaidAtTaiwan" class="form-label">付款時間（台灣）</label><input name="PaidAtTaiwan" id="PaidAtTaiwan" type="datetime-local" value="@ViewData["PaidAtTaiwan"]" class="form-control" required /></div>
            <div><label for="PaymentNote" class="form-label">收款備註</label><input name="Note" id="PaymentNote" maxlength="500" class="form-control" /></div>
            <div class="form-check ms-2"><input name="ConfirmDetails" id="ConfirmDetails" type="checkbox" value="true" class="form-check-input" required /><label for="ConfirmDetails" class="form-check-label">已核對購買對象、實收金額與方案內容。</label></div>
        </div><div class="mt-3"><button class="btn btn-primary" type="submit">確認收款並啟用</button></div>
    </form> }
    @if (User.IsInRole("Admin")) { <form asp-action="Cancel" method="post" class="card card-body mb-3">
        <h2 class="h5">取消待付款訂單</h2><input name="Id" type="hidden" value="@Model.LessonPassId" /><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)" />
        <label for="CancelNote" class="form-label">取消原因</label><input name="Note" id="CancelNote" maxlength="400" class="form-control mb-2" required />
        <div><button class="btn btn-outline-danger" type="submit">取消尚未收款訂單</button></div>
    </form> }
}
<a asp-action="Index" class="btn btn-outline-secondary">返回方案購買紀錄</a>
