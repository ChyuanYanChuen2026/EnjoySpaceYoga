@model EnjoySpace.Web.Areas.Admin.ViewModels.TrialGuestEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "新增體驗生" : "編輯體驗生"; }
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="Id" type="hidden" /><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion ?? [])" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label">姓名</label><input asp-for="Name" class="form-control" maxlength="100" required /></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label">電話</label><input asp-for="Phone" class="form-control" maxlength="30" required /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" maxlength="200" /></div>
        <div class="col-md-6"><label asp-for="LineId" class="form-label">LINE ID</label><input asp-for="LineId" class="form-control" maxlength="100" /></div>
        <div class="col-md-6"><label asp-for="SourceType" class="form-label">來源</label><select asp-for="SourceType" class="form-select"><option value="Direct">自行詢問</option><option value="Referral">學生介紹</option><option value="Other">其他</option></select></div>
        <div class="col-md-6"><label asp-for="ReferrerStudentId" class="form-label">介紹學生（來源為學生介紹時必填）</label><select asp-for="ReferrerStudentId" asp-items="Model.Referrers" class="form-select"><option value="">請選擇</option></select></div>
        <div><label asp-for="Note" class="form-label">備註</label><textarea asp-for="Note" class="form-control" maxlength="500"></textarea></div>
        <div class="form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">啟用</label></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary" type="submit">儲存</button> <a asp-action="Index" class="btn btn-outline-secondary">返回</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link">重新載入</a></div>
</form>
