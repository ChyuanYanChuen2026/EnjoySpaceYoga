@model EnjoySpace.Web.Areas.Admin.ViewModels.PagedRecords<EnjoySpace.Web.Models.Entities.TrialGuest>
@{ ViewData["Title"] = "體驗生管理"; }
<h1 class="h3">體驗生管理</h1>
<a asp-action="Edit" class="btn btn-primary mb-3">新增體驗生</a>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="table-responsive card card-body"><table class="table align-middle">
    <thead><tr><th>姓名</th><th>聯絡方式</th><th>來源</th><th>狀態</th><th>操作</th></tr></thead>
    <tbody>@foreach (var g in Model.Items) {
        <tr><td>@g.Name</td><td>@g.Phone<br />@g.Email<br />@g.LineId</td>
            <td>@(g.SourceType == "Referral" ? "學生介紹" : g.SourceType == "Direct" ? "自行詢問" : "其他")</td>
            <td>@(g.ConvertedStudentId.HasValue ? "已轉正式生" : g.Status == "Active" ? "啟用" : "停用")</td><td>
                <a asp-action="Edit" asp-route-id="@g.TrialGuestId">編輯</a>
                @if (g.Status == "Active" && g.ConvertedStudentId == null) { <a asp-controller="LessonPasses" asp-action="Create" asp-route-ownerType="TrialGuest" asp-route-ownerId="@g.TrialGuestId" class="ms-2">購買體驗方案</a> }
            </td></tr>
    }</tbody></table>
    @if (Model.TotalCount == 0) { <p>尚無體驗生。</p> }
</div>
<p class="mt-3">共 @Model.TotalCount 筆，第 @Model.Page / @Model.PageCount 頁</p>
@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">上一頁</a> }
@if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">下一頁</a> }
