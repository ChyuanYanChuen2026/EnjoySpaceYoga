@using EnjoySpace.Web.Models
@model IReadOnlyList<EnjoySpace.Web.Models.Entities.EnrollmentApplication>
@{ ViewData["Title"] = "報名管理"; }
<h1 class="h3">報名管理</h1>
<div class="d-flex flex-wrap gap-2 my-3">
    <a asp-action="Create" class="btn btn-primary">新增報名</a>
    <a asp-action="Index" class="btn btn-outline-secondary">待審核</a>
    <a asp-action="Index" asp-route-all="true" class="btn btn-outline-secondary">全部申請</a>
</div>
<p class="text-secondary">@(ViewBag.All == true ? "全部狀態" : "待審核") · 最近 200 筆，先付款再審核。</p>
<div class="card card-body table-responsive"><table sort-set="applications" class="table align-middle">
<thead><tr><th sort-key="name">學生</th><th sort-key="course">學期／課程</th><th sort-key="price">報價</th><th sort-key="payment">付款</th><th sort-key="status">審核</th><th></th></tr></thead>
<tbody>@foreach (var item in Model)
{
    <tr><td>@item.Student.User.DisplayName</td><td>@item.Course.Term.Name · @item.Course.Name</td>
    <td class="text-nowrap">@item.QuotedSessionCount 堂／@item.QuotedAmount.ToString("N2")</td>
    <td>@WorkflowLabels.Payment(item.Payment?.Status)</td><td>@WorkflowLabels.Application(item.Status)</td>
    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">查看</a></td></tr>
}</tbody></table>
@if (Model.Count == 0) { <p>目前沒有符合條件的報名。</p> }
</div>

