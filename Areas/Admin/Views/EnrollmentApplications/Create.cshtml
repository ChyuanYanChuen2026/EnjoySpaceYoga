@model EnjoySpace.Web.Areas.Admin.ViewModels.EnrollmentCreateModel
@{ 
    ViewData["Title"] = "新增報名"; 
}
<h1 class="h3">新增整期報名</h1>
<p class="text-secondary">步驟 1：選擇學生與課程。下一步核對完整課表、堂數、金額與不提供退課退款政策，確認後才建立申請。</p>
@if (Model.Courses.Count == 0)
{
    <div class="alert alert-info">目前沒有已確認排課完成並開放報名的課程，請先至學期管理核對整期課表。</div>
}
<form asp-action="Create" method="post" class="card card-body" style="max-width:48rem">

    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <label asp-for="StudentId" class="form-label"></label>

    <select asp-for="StudentId" asp-items="Model.Students" class="form-select mb-3">
        <option value="">請選擇學生</option>
    </select>

    <label asp-for="CourseId" class="form-label"></label>

    <select asp-for="CourseId" asp-items="Model.Courses" class="form-select mb-3">
        <option value="">請選擇課程</option>
    </select>

    <div>
        <button class="btn btn-primary">下一步：核對完整報名內容</button>
        <a asp-action="Index" class="btn btn-outline-secondary">返回</a>
    </div>
</form>

