@model EnjoySpace.Web.Areas.Admin.ViewModels.EnrollmentPreviewModel
@using EnjoySpace.Web.Services
@{ 
    ViewData["Title"] = "確認整期報名"; 
}
<h1 class="h3">確認整期報名</h1>
<p class="text-secondary">步驟 2：請與學生逐項核對。此頁尚未建立申請或應收款。</p>
<div class="card card-body mb-3">
    <p><strong>學生：</strong>@Model.StudentName（@Model.StudentAccount）</p>
    <p><strong>學期／課程：</strong>@Model.TermName · @Model.CourseName</p>
    <p><strong>整期堂數：</strong>@Model.Sessions.Count 堂　<strong>整期金額：</strong>NT$ @Model.Amount.ToString("N0")</p>
    <div class="table-responsive">
        <table class="table" data-sort-local>
            <thead><tr><th data-sort-type="number">開始時間（台灣）</th><th data-sort-type="number">結束時間（台灣）</th><th data-sort-type="text">老師</th><th data-sort-type="text">地點</th></tr></thead>
            <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr><td data-sort-value="@session.StartsAt.ToUnixTimeMilliseconds()">@session.StartsAt.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm")</td>
                        <td data-sort-value="@session.EndsAt.ToUnixTimeMilliseconds()">@session.EndsAt.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@session.TeacherName</td><td>@session.LocationName</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<form asp-action="ConfirmCreate" method="post" class="card card-body">
    <input asp-for="StudentId" type="hidden" />
    <input asp-for="CourseId" type="hidden" />
    <input asp-for="ConfirmationToken" type="hidden" />
    <div class="alert alert-warning">@EnrollmentWorkflowService.NoRefundPolicy</div>
    <div class="form-check mb-3">
        <input asp-for="ConfirmDetails" class="form-check-input" required />
        <label asp-for="ConfirmDetails" class="form-check-label">我已與學生核對身分、課程、所有上課日期、堂數及整期金額，確認可以報名。</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="ConfirmNoRefund" class="form-check-input" required />
        <label asp-for="ConfirmNoRefund" class="form-check-label">我已告知學生報名後不提供退課退款，並取得學生確認。</label>
    </div>
    <p class="text-secondary">確認有效時間為 30 分鐘；學生或課表內容變動後須重新核對。</p>
    <div><button class="btn btn-primary">確認無誤，建立報名與應收款</button>
        <a asp-action="Create" class="btn btn-outline-secondary">返回重新選擇</a></div>
</form>
