@model List<EnjoySpace.Web.Models.Entities.PortalTrialRequest>
@{ ViewData["Title"] = "官網體驗申請"; }
<h1>官網體驗申請</h1>
<p class="text-muted">與 Vue 官網共用資料。申請不佔正式名額；請聯繫確認後，依現有方案購買與收款流程處理。</p>
@if (TempData["Success"] is string message) { <div class="alert alert-info">@message</div> }
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>申請人</th><th>課程／場次</th><th>方案報價</th><th>備註</th><th>狀態</th><th>處理</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><a asp-controller="TrialGuests" asp-action="Edit" asp-route-id="@item.TrialGuestId">@item.TrialGuest.Name</a><br />@item.TrialGuest.Phone<br />@item.TrialGuest.Email</td>
        <td>@item.ClassSession.Course.Name<br />@item.ClassSession.StartsAt.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm")</td>
        <td>@item.PlanName<br />NT$ @item.QuotedPrice.ToString("N0")</td><td>@item.Note</td>
        <td>@(item.Status == "Pending" ? "待聯繫" : item.Status == "Contacted" ? "已聯繫" : "已取消")</td>
        <td>@if (item.Status != "Cancelled") { <form asp-action="Update" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="expectedStatus" value="@item.Status"/><button class="btn btn-sm btn-success" name="status" value="Contacted">已聯繫</button> <button class="btn btn-sm btn-outline-secondary" name="status" value="Cancelled">取消申請</button></form> }</td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <p>目前沒有官網體驗申請。</p> }
@if (ViewBag.Page > 1) { <a asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" class="btn btn-outline-secondary">上一頁</a> }
@if (ViewBag.Page * 30 < ViewBag.Total) { <a asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" class="btn btn-outline-secondary">下一頁</a> }
