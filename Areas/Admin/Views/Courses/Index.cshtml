@model IReadOnlyList<EnjoySpace.Web.Models.Entities.Course>
@using EnjoySpace.Web.Areas.Admin.ViewModels

@{
    ViewData["Title"] = "課程管理";
}

<div class="mb-4">
    <h1 class="h3 mb-2">課程管理</h1>
    <p class="text-secondary mb-0">
        管理每一期固定班的基本資料。
    </p>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="mb-3">
    <a asp-area="Admin"  asp-controller="Courses" asp-action="Create"  class="btn btn-primary"> 新增課程</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-secondary mb-0">目前沒有課程資料。</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">學期名稱</th>
                            <th scope="col">課程名稱</th>
                            <th scope="col">預設名額</th>
                            <th scope="col">期課價格</th>
                            <th scope="col">狀態</th>
                            <th scope="col">學期期間</th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>@course.Term.Name</td>
                                <td>@course.Name</td>
                                <td>@course.DefaultCapacity</td>
                                <td class="text-nowrap">NT$ @course.TermPrice.ToString("N2")</td>
                                <td class="text-nowrap">@(course.IsActive ? "啟用" : "停用")／@(course.IsPubliclyVisible ? "公開" : "不公開")</td>
                                <td class="text-nowrap">@course.Term.StartDate.ToString("yyyy/MM/dd")～@course.Term.EndDate.ToString("yyyy/MM/dd")</td>
                                <td class="text-nowrap">
                                    @if (course.Term.Status == TermStatusOptions.Draft)
                                    {
                                        <a asp-area="Admin" asp-controller="Courses" asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary">
                                            編輯
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">學期已@(TermStatusOptions.GetText(course.Term.Status))</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
