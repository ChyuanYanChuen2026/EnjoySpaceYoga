@model EnjoySpace.Web.Areas.Admin.ViewModels.CourseCreateViewModel

@{
    ViewData["Title"] = "新增課程";
}

<h1 class="h3 mb-4">新增課程</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Courses"  asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"  class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TermId" class="form-label"></label>
                <select asp-for="TermId" asp-items="Model.TermOptions" class="form-select">
                    <option value="">請選擇學期</option>
                </select>
                <span asp-validation-for="TermId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ClassCategoryId" class="form-label"></label>
                <select asp-for="ClassCategoryId"  asp-items="Model.ClassCategoryOptions"  class="form-select">
                    <option value="">請選擇課程分類</option>
                </select>
                <span asp-validation-for="ClassCategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DefaultTeacherId" class="form-label"></label>
                <select asp-for="DefaultTeacherId" asp-items="Model.TeacherOptions"  class="form-select">
                    <option value="">請選擇預設老師</option>
                </select>
                <span asp-validation-for="DefaultTeacherId"  class="text-danger"></span>
            </div>

             <div class="mb-3">
                <label asp-for="DefaultLocationId" class="form-label"></label>
                <select asp-for="DefaultLocationId" asp-items="Model.LocationOptions" class="form-select">
                    <option value="">請選擇預設地點</option>
                </select>
                <span asp-validation-for="DefaultLocationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>


            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DefaultCapacity" class="form-label"></label>
                    <input asp-for="DefaultCapacity" type="number" min="1" max="32767" step="1" class="form-control" />
                    <span asp-validation-for="DefaultCapacity" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TermPrice" class="form-label"></label>
                    <input asp-for="TermPrice" asp-format="{0:0.##}" type="number" min="0" max="99999999.99" step="0.01" class="form-control" />
                    <span asp-validation-for="TermPrice" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="form-check"><input asp-for="IsPubliclyVisible" class="form-check-input" /><label asp-for="IsPubliclyVisible" class="form-check-label"></label></div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="form-check"><input asp-for="AllowsFlexibleBooking" class="form-check-input" /><label asp-for="AllowsFlexibleBooking" class="form-check-label"></label></div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="form-check"><input asp-for="AllowsMakeup" class="form-check-input" /><label asp-for="AllowsMakeup" class="form-check-label"></label></div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary"> 儲存課程</button>

            <a asp-area="Admin" asp-controller="Courses"  asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
        </form>
    </div>
</div>
