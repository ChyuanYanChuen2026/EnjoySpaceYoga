@model EnjoySpace.Web.Areas.Admin.ViewModels.CatalogListViewModel<EnjoySpace.Web.Areas.Admin.ViewModels.TermListItemViewModel>
@using EnjoySpace.Web.Areas.Admin.ViewModels

@{
    ViewData["Title"] = "學期管理";
}

@functions {
    private static string FormatTaiwanTime(DateTime? value)
    {
        if (!value.HasValue)  return "未設定";

        var utc = DateTime.SpecifyKind(value.Value, DateTimeKind.Utc);

        return new DateTimeOffset(utc).ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm");
    }
}

<h1 class="h3 mb-2">學期管理</h1>
<p class="text-muted">共 @Model.Controls.TotalCount 個符合條件的學期。報名時間以台灣時間顯示。</p>
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">新增學期</a>
</div>

<partial name="_CatalogFilters" model="Model.Controls" />
<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted mb-0">沒有符合條件的學期資料。</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="text-nowrap">學期名稱</th>
                            <th scope="col" class="text-nowrap">開始日期</th>
                            <th scope="col" class="text-nowrap">結束日期</th>
                            <th scope="col" class="text-nowrap">報名開始時間</th>
                            <th scope="col" class="text-nowrap">報名結束時間</th>
                            <th scope="col" class="text-nowrap">狀態</th>
                            <th scope="col" class="text-nowrap">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var term in Model.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@term.Name</td>
                                <td class="text-nowrap">@(term.StartDate.ToString("yyyy/MM/dd"))</td>
                                <td class="text-nowrap">@(term.EndDate.ToString("yyyy/MM/dd"))</td>
                                <td class="text-nowrap">@FormatTaiwanTime(term.RegistrationStartAtUtc)</td>
                                <td class="text-nowrap">@FormatTaiwanTime(term.RegistrationEndAtUtc) </td>
                                <td class="text-nowrap">@TermStatusOptions.GetText(term.Status)</td>
                                <td class="text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@term.TermId" class="btn btn-sm btn-outline-primary">編輯</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<partial name="_CatalogPagination" model="Model.Controls" />
