@model EnjoySpace.Web.Areas.Admin.ViewModels.TermEditViewModel
@using EnjoySpace.Web.Areas.Admin.ViewModels

@{
    ViewData["Title"] = "編輯學期";
}

<h1 class="h3 mb-2">編輯學期</h1>
<p class="text-muted">修改學期日期與報名開放時間。時間請填寫台灣時間。</p>

<div class="card card-body mb-3">
    <h2 class="h5">整期排課核對</h2>
    <p>請先完成所有啟用課程的整期場次，再統一開放報名。開放後，即使停止報名，也不能直接增刪場次或修改課程。</p>
    <p class="text-secondary">若整個學期從未有報名紀錄，可先停止報名，再將學期改回草稿以修正課表；重新開放時須再次確認。已有報名紀錄時不能退回草稿。</p>
    @if (Model.ScheduleConfirmedAtUtc.HasValue)
    {
        <p>最近排課確認：@(new DateTimeOffset(DateTime.SpecifyKind(Model.ScheduleConfirmedAtUtc.Value, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm"))（台灣時間）</p>
    }
    <div class="table-responsive">
        <table class="table" data-sort-local>
            <thead><tr><th data-sort-type="text">課程</th><th data-sort-type="text">狀態</th><th data-sort-type="number">場次數</th><th data-sort-type="number">首堂～末堂（台灣時間）</th><th>核對</th></tr></thead>
            <tbody>
                @foreach (var course in Model.Schedule)
                {
                    <tr>
                        <td>@course.Name</td><td>@(course.IsActive ? "啟用" : "停用，不開放報名")</td>
                        <td>@course.SessionCount</td>
                        <td data-sort-value="@(course.FirstSessionAt?.ToUnixTimeMilliseconds().ToString() ?? "")">@(course.FirstSessionAt?.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm") ?? "未排課") ～ @(course.LastSessionAt?.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm") ?? "未排課")</td>
                        <td><a asp-controller="ClassSessions" asp-action="Index" asp-route-TermId="@Model.TermId" asp-route-CourseId="@course.CourseId" target="_blank" rel="noopener">查看完整場次</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Schedule.Count == 0) { <p class="text-danger">尚未建立課程，無法開放報名。</p> }
</div>

<div class="card">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Terms" asp-action="Edit" asp-route-id="@Model.TermId" method="post">
            <input asp-for="TermId" type="hidden" />
            <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />

            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="RegistrationStartAtTaiwan" class="form-label"></label>
                    <input asp-for="RegistrationStartAtTaiwan" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control" />
                    <span asp-validation-for="RegistrationStartAtTaiwan" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="RegistrationEndAtTaiwan" class="form-label"></label>
                    <input asp-for="RegistrationEndAtTaiwan" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control" />
                    <span asp-validation-for="RegistrationEndAtTaiwan" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var option in TermStatusOptions.Items)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <p class="text-muted mb-0">報名時間可以留空；若兩者皆填寫，結束時間必須晚於開始時間。</p>
                </div>
                <div class="col-12 form-check ms-2">
                    <input asp-for="ConfirmScheduleComplete" class="form-check-input" />
                    <label asp-for="ConfirmScheduleComplete" class="form-check-label"></label>
                    <p class="text-muted">首次開放或重新開放報名時必須勾選。系統會檢查每門啟用課程均有場次；完整堂數仍須由管理員核對。</p>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">儲存修改</button>
                <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
