@model EnjoySpace.Web.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "儀表板";
    var today = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8));
}
<div class="dashboard-heading">
    <div><h1>管理儀表板</h1><p>歡迎回來，這裡是課程與報名的最新概況。</p></div>
    <time class="dashboard-date" datetime="@today.ToString("yyyy-MM-dd")">@today.ToString("yyyy年M月d日") · 台灣時間</time>
</div>
<div class="dashboard-stats">
    <section class="card stat-card">
        <h2 class="stat-title mb-0"><partial name="_UiIcon" model='"check"' />待審核報名</h2>
        <p class="stat-number">@Model.PendingEnrollmentCount</p>
        <div class="stat-bottom"><a asp-area="Admin" asp-controller="EnrollmentApplications" asp-action="Index">查看申請<partial name="_UiIcon" model='"arrow"' /></a></div>
    </section>
    <section class="card stat-card">
        <h2 class="stat-title mb-0"><partial name="_UiIcon" model='"calendar"' />今日課程數</h2>
        <p class="stat-number">@Model.TodayClassSessionCount</p>
        <div class="stat-bottom">依台灣時間計算</div>
    </section>
    <section class="card stat-card">
        <h2 class="stat-title mb-0"><partial name="_UiIcon" model='"book"' />固定期課總數</h2>
        <p class="stat-number">@Model.CourseCount</p>
        <div class="stat-bottom">目前建立的固定期課</div>
    </section>
    <section class="card stat-card">
        <h2 class="stat-title mb-0"><partial name="_UiIcon" model='"wallet"' />待確認付款</h2>
        <p class="stat-number">@Model.PendingPaymentCount</p>
        <div class="stat-bottom"><a asp-area="Admin" asp-controller="Payments" asp-action="Index">查看付款<partial name="_UiIcon" model='"arrow"' /></a></div>
    </section>
</div>
@await Component.InvokeAsync("TrialReviewNotice")
<section class="card calendar-panel">
    <div class="card-body">
        <div class="calendar-intro"><h2 class="h5">課程行事曆</h2><p>時間皆以台灣時間顯示，點選場次可查看詳細資料。</p></div>
        <div id="calendarLegend" class="calendar-legend" hidden>
            <label>配色
                <select id="calendarColorBy">
                    <option value="term">依檔期</option>
                    <option value="course">依課程</option>
                </select>
            </label>
            <ul aria-label="目前顯示的課程色彩圖例"></ul>
        </div>
        <div id="calendarError" class="alert alert-danger d-none" role="alert">無法載入課程資料，請重新整理頁面。</div>
        <div id="calendar" data-events-url="@Url.Action("Events", "ClassSessions", new { area = "Admin" })"></div>
    </div>
</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.21/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@@3.7.2/build/global/luxon.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@@6.1.21/locales/zh-tw.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/luxon3@@6.1.21/index.global.min.js"></script>
    <script src="~/js/dashboard-calendar.js" asp-append-version="true"></script>
}
