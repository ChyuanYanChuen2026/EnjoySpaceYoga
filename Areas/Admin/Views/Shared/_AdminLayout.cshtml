<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]｜Enjoy Space 後台</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-dark bg-dark" aria-label="後台導覽">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="Admin"  asp-controller="Dashboard" asp-action="Index"> Enjoy Space 米亞工作室 </a>
                <div class="d-flex gap-2 align-items-center">
                    <span class="navbar-text">@User.Identity?.Name</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">登出</button></form>
                    }
                    else { <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light">管理員登入</a> }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4">
        <div class="row g-4">
            <aside class="col-12 col-md-3 col-lg-2">
                <nav class="list-group" aria-label="後台功能">
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"> 儀表板</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="ClassSessions" asp-action="Index">場次管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="LeaveMakeup" asp-action="Index">請假與補課</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="TrialGuests" asp-action="Index">體驗生管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="PortalTrials" asp-action="Index">官網體驗申請</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="LessonPlans" asp-action="Index">方案管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="LessonPasses" asp-action="Index">方案購買紀錄</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Courses" asp-action="Index"> 課程管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Terms" asp-action="Index">學期管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="EnrollmentApplications" asp-action="Index">待審核報名</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Payments" asp-action="Index">付款管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="CourseEnrollments" asp-action="Index">正式報名名單</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Students" asp-action="Index">學生管理</a>
                    <a class="list-group-item list-group-item-action" asp-area="Admin" asp-controller="Teachers" asp-action="Index">老師管理</a>
                </nav>
            </aside>

            <main class="col-12 col-md-9 col-lg-10">
                @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
