@model EnjoySpace.Web.Areas.Admin.ViewModels.LeaveCreateModel
@{ ViewData["Title"] = "登記請假"; }
<h1 class="h3">登記請假</h1>
<p>@Model.StudentName · @Model.CourseName · @Model.StartsAt.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy/MM/dd HH:mm")（台灣時間）</p>
<p class="text-secondary">上課前可請假。送出後釋出本堂名額，並取得一筆原學期日期範圍內的補課資格，可選其他課程。取消請假時會重新檢查名額。</p>

<form asp-action="Leave" method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="ParticipantId" type="hidden" />
    <input type="hidden" name="returnToSession" value="@((ViewData["ReturnToSession"] is true).ToString().ToLowerInvariant())" />
    <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? [])" />
    <label asp-for="Reason" class="form-label">請假原因</label>
    <textarea asp-for="Reason" maxlength="500" rows="3" class="form-control" required></textarea>
    <div class="mt-3"><button class="btn btn-primary" type="submit">確認登記請假</button>
        <a asp-controller="ClassSessions" asp-action="Details" asp-route-id="@Model.SessionId" asp-fragment="attendance" class="btn btn-outline-secondary">返回場次與名單</a>
        <a asp-action="Leave" asp-route-participantId="@Model.ParticipantId" asp-route-returnToSession="@(ViewData["ReturnToSession"] is true)" class="btn btn-link">重新載入最新資料</a></div>
</form>
