@model EnjoySpace.Web.Areas.Admin.ViewModels.MakeupCreateModel
@{ ViewData["Title"] = "申請補課"; }
<h1 class="h3">申請補課</h1>
<p>學生：@Model.StudentName</p><p>原請假：@Model.SourceDescription</p>
<p>可補課日期（台灣）：@Model.PeriodStart.ToString("yyyy/MM/dd") ～ @Model.PeriodEnd.ToString("yyyy/MM/dd")</p>
<p class="text-secondary">可選上述期間內其他課程的場次，不限相同學期資料。須開放補課、尚未開始、未停課且有空位，並排除已在名單中的課堂。送出申請後保留資格，核准時會再次檢查日期與名額。</p>
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (Model.Targets.Count == 0)
{
    <div class="alert alert-info">目前沒有符合條件的補課場次，資格仍保留。</div>
}
else
{
    <form asp-action="Apply" method="post" class="card card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="EntitlementId" type="hidden" />
        <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? [])" />
        <label asp-for="TargetSessionId" class="form-label">補課場次（台灣時間）</label>
        <select asp-for="TargetSessionId" asp-items="Model.Targets" class="form-select" required><option value="">請選擇場次</option></select>
        <div class="mt-3"><button class="btn btn-primary" type="submit">送出補課申請</button>
            <a asp-action="Apply" asp-route-entitlementId="@Model.EntitlementId" class="btn btn-link">重新載入最新資料</a></div>
    </form>
}
<a asp-action="Index" asp-route-tab="entitlements" class="btn btn-outline-secondary mt-3">返回補課資格</a>
