@model EnjoySpace.Web.Areas.Admin.ViewModels.LessonPlanEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "新增方案" : "編輯方案"; }
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="Id" type="hidden" /><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion ?? [])" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="PlanCode" class="form-label">方案代碼</label><input asp-for="PlanCode" class="form-control" maxlength="50" required /></div>
        <div class="col-md-6"><label asp-for="PlanName" class="form-label">方案名稱</label><input asp-for="PlanName" class="form-control" maxlength="100" required /></div>
        <div class="col-md-6"><label asp-for="PlanType" class="form-label">方案類型／購買對象</label><select asp-for="PlanType" class="form-select"><option value="Trial">體驗方案（體驗生）</option><option value="Flexible">堂券方案（正式學生）</option></select></div>
        <div class="col-md-3"><label asp-for="SessionQuota" class="form-label">堂數</label><input asp-for="SessionQuota" type="number" min="1" max="32767" class="form-control" required /></div>
        <div class="col-md-3"><label asp-for="Price" class="form-label">價格（元）</label><input asp-for="Price" type="number" step="0.01" min="0" max="99999999.99" class="form-control" required /></div>
        <div class="col-md-6"><label asp-for="ValidityUnit" class="form-label">效期類型</label><select asp-for="ValidityUnit" class="form-select"><option value="Days">指定天數（含生效日）</option><option value="Months">日曆月份（至到期對應日前一天）</option><option value="Unlimited">不限期</option></select></div>
        <div class="col-md-6"><label asp-for="ValidityValue" class="form-label">有效天數／月數（不限期時不使用）</label><input asp-for="ValidityValue" type="number" min="1" max="32767" class="form-control" /></div>
        <div class="form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">啟用，可供購買</label></div>
        <div class="form-check ms-2"><input asp-for="RequiresReferrer" class="form-check-input" /><label asp-for="RequiresReferrer" class="form-check-label">體驗申請須填寫介紹人（由工作室人工核對）</label></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary" type="submit">儲存</button> <a asp-action="Index" class="btn btn-outline-secondary">返回</a> <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link">重新載入</a></div>
</form>
