@model EnjoySpace.Web.Areas.Admin.ViewModels.PagedRecords<EnjoySpace.Web.Models.Entities.LessonPlan>
@{ ViewData["Title"] = "方案管理"; }
<h1 class="h3">方案管理</h1>
<p class="text-secondary">價格、堂數及效期由管理員設定。修改方案不影響既有購買紀錄。</p>
<a asp-action="Edit" class="btn btn-primary mb-3">新增方案</a>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="table-responsive card card-body"><table class="table align-middle">
    <thead><tr><th>方案</th><th>對象</th><th>堂數／價格</th><th>效期</th><th>狀態</th><th>操作</th></tr></thead>
    <tbody>@foreach (var p in Model.Items) {
        <tr><td>@p.PlanName<br /><small>@p.PlanCode</small></td><td>@EnjoySpace.Web.Models.LessonPlanLabels.Audience(p.AudienceType)</td>
            <td>@p.SessionQuota 堂／$@p.Price.ToString("N2")</td><td>@EnjoySpace.Web.Models.LessonPlanLabels.Validity(p.ValidityUnit, p.ValidityValue)</td>
            <td>@(p.IsActive ? "啟用" : "停用")</td><td><a asp-action="Edit" asp-route-id="@p.LessonPlanId">編輯</a></td></tr>
    }</tbody></table>@if (Model.TotalCount == 0) { <p>尚無方案，請先新增。</p> }</div>
<p class="mt-3">共 @Model.TotalCount 筆，第 @Model.Page / @Model.PageCount 頁</p>
@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">上一頁</a> }
@if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">下一頁</a> }
