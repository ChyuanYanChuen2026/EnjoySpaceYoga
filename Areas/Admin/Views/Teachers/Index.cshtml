@model List<EnjoySpace.Web.Areas.Admin.ViewModels.TeacherListItemViewModel>

@{
    ViewData["Title"] = "老師管理";
}

<h1 class="h3 mb-2">老師管理</h1>
<p class="text-muted">共 @Model.Count 位老師。</p>
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">新增老師</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">目前沒有老師資料。</p>
        }
        else
        {
            <div class="table-responsive">
                <table sort-set="teachers" class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th sort-key="number" scope="col" class="text-nowrap">老師編號</th>
                            <th sort-key="name" scope="col" class="text-nowrap">姓名</th>
                            <th sort-key="phone" scope="col" class="text-nowrap">電話</th>
                            <th sort-key="email" scope="col">Email</th>
                            <th sort-key="status" scope="col" class="text-nowrap">老師狀態</th>
                            <th sort-key="account" scope="col" class="text-nowrap">登入帳號</th>
                            <th scope="col" class="text-nowrap">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@(teacher.TeacherNo ?? "未設定") </td>
                                <td class="text-nowrap">@teacher.DisplayName </td>
                                <td class="text-nowrap">@(teacher.Phone ?? "未提供")</td>
                                <td>@(teacher.Email ?? "未提供")</td>
                                <td class="text-nowrap">
                                    <span class="badge @(teacher.IsActive ? "bg-success" : "bg-secondary")">@(teacher.IsActive ? "啟用" : "停用") </span>
                                </td>
                                <td class="text-nowrap">
                                    <span class="badge @(teacher.IsUserActive ? "bg-success" : "bg-secondary")">@(teacher.IsUserActive ? "啟用" : "停用") </span>
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@teacher.TeacherId"  class="btn btn-sm btn-outline-primary">編輯</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>