@model EnjoySpace.Web.Areas.Admin.ViewModels.AttendanceRosterViewModel
@using EnjoySpace.Web.Areas.Admin.ViewModels
@{
    ViewData["Title"] = "課堂名單與出缺席";
    var taiwan = TimeSpan.FromHours(8);
    var active = Model.Participants.Where(x => x.IsActive).ToList();
}

<h1 class="h3 mb-3">課堂名單與出缺席</h1>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5">@Model.CourseName</h2>
        <p class="mb-1">@Model.TeacherName · @Model.LocationName</p>
        <p class="mb-0">@Model.StartsAt.ToOffset(taiwan).ToString("yyyy/MM/dd HH:mm") ～ @Model.EndsAt.ToOffset(taiwan).ToString("HH:mm")（台灣時間）</p>
    </div>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<p>有效名單 @active.Count 人：未點名 @active.Count(x => x.Status == "Scheduled")、出席 @active.Count(x => x.Status == "Present")、遲到 @active.Count(x => x.Status == "Late")、缺席 @active.Count(x => x.Status == "Absent")。</p>
@if (!Model.HasStarted)
{
    <div class="alert alert-info">課堂尚未開始，可以查看名單；開始後才能登記出缺席。</div>
}
<p class="text-secondary">每位學員分別儲存。更正已登記的狀態時，請填寫原因；未點名不會自動算成缺席。</p>
@if (Model.Participants.Count == 0)
{
    <div class="alert alert-light border">目前沒有正式入班的學員。報名核准後，學員會自動加入每堂名單。</div>
}
@foreach (var row in Model.Participants)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6">@row.StudentName <span class="text-secondary">@(row.StudentNo ?? "未設定學號")</span>
                <span class="badge bg-secondary">@AttendanceStatuses.Labels.GetValueOrDefault(row.Status, row.Status)</span>
                @if (!row.IsActive) { <span class="badge bg-warning text-dark">非有效名單</span> }
            </h2>
            <form asp-area="Admin" asp-controller="Attendance" asp-action="Record" method="post">
                <input type="hidden" name="SessionId" value="@Model.SessionId" />
                <input type="hidden" name="ParticipantId" value="@row.ParticipantId" />
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(row.RowVersion)" />
                <fieldset disabled="@(!Model.HasStarted || !row.IsActive)">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label for="status-@row.ParticipantId" class="form-label">出缺席</label>
                            <select id="status-@row.ParticipantId" name="Status" class="form-select" required>
                                @foreach (var status in AttendanceStatuses.Labels)
                                {
                                    <option value="@status.Key" selected="@(status.Key == row.Status)">@status.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label for="reason-@row.ParticipantId" class="form-label">備註／更正原因</label>
                            <input id="reason-@row.ParticipantId" name="ManualReason" value="@row.ManualReason" maxlength="500" class="form-control" />
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100" aria-label="儲存 @row.StudentName 的出缺席">儲存</button></div>
                    </div>
                </fieldset>
            </form>
            @if (row.UpdatedAtUtc.HasValue)
            {
                <p class="small text-secondary mt-2 mb-0">最後登記：@row.UpdatedBy · @DateTime.SpecifyKind(row.UpdatedAtUtc.Value, DateTimeKind.Utc).AddHours(8).ToString("yyyy/MM/dd HH:mm:ss")（台灣時間）</p>
            }
        </div>
    </div>
}
<a asp-area="Admin" asp-controller="ClassSessions" asp-action="Details" asp-route-id="@Model.SessionId" class="btn btn-outline-secondary">返回場次詳細</a>
