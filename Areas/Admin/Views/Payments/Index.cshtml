@using EnjoySpace.Web.Models
@model EnjoySpace.Web.Areas.Admin.ViewModels.PaymentListModel
@{ 
    ViewData["Title"] = "付款管理"; 
}

<h1 class="h3">付款管理</h1>

<p class="text-secondary">期課報名、體驗方案與堂券款項。退款按鈕僅登記未獲核准期課申請的人工退款。</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card card-body table-responsive">
    <table sort-set="payments" class="table align-middle">
        <thead>
            <tr>
                <th sort-key="name">學生／課程</th>
                <th sort-key="amount">金額</th>
                <th sort-key="status">狀態</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@(item.Payment.Student?.User.DisplayName ?? item.Payment.TrialGuest?.Name)<br />@item.Description</td>
                <td class="text-nowrap">@item.Payment!.Amount.ToString("N2")</td><td>@WorkflowLabels.Payment(item.Payment.Status)</td>
                <td>
                @if (item.ApplicationId.HasValue) { <a asp-controller="EnrollmentApplications" asp-action="Details" asp-route-id="@item.ApplicationId">查看報名／確認付款</a> }
                @if (item.PassId.HasValue) { <a asp-controller="LessonPasses" asp-action="Details" asp-route-id="@item.PassId">查看方案／確認付款</a> }
                @if (item.Payment.Status == "RefundPending" && item.ApplicationId.HasValue)
                {
                    <form asp-action="Refund" method="post" class="mt-2">
                        <input type="hidden" name="paymentId" value="@item.Payment.PaymentId" />
                        <label for="refund-@item.Payment.PaymentId" class="form-label">實際退款時間、方式與憑據</label>
                        <input id="refund-@item.Payment.PaymentId" name="note" required maxlength="400" class="form-control mb-2" />
                        <button class="btn btn-sm btn-outline-danger">登記已完成退款</button>
                    </form>
                }
                @if (item.Payment.Status == "Refunded") { <p class="small mt-2">@item.Payment.Note</p> }
                </td>
            </tr>
        }
        </tbody>
    </table>
@if (Model.TotalCount == 0) { <p>目前沒有款項。</p> }
</div>
<p class="mt-3">共 @Model.TotalCount 筆，第 @Model.Page / @Model.PageCount 頁</p>
@if (Model.Page > 1) { <a asp-action="Index" asp-route-sort="@Context.Request.Query["Sort"]" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">上一頁</a> }
@if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-sort="@Context.Request.Query["Sort"]" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">下一頁</a> }

