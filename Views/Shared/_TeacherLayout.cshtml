@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]｜Enjoy Space 老師</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tempus-dominus/tempus-dominus.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/date-time-picker.css" asp-append-version="true" />
</head>
<body class="admin-app">
    <a href="#main-content" class="skip-link">跳至主要內容</a>
    <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="teacherNavigation" aria-labelledby="teacherNavigationTitle">
        <div class="sidebar-brand"><a class="es-brand" asp-controller="TeacherDashboard" asp-action="Index"><partial name="_BrandMark" /><span><strong>Enjoy Space</strong><small>米亞工作室</small></span></a></div>
        <div class="offcanvas-header"><h2 class="h6 mb-0" id="teacherNavigationTitle">老師功能選單</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#teacherNavigation" aria-label="關閉選單"></button></div>
        <div class="offcanvas-body"><nav aria-label="老師功能">
            <div class="sidebar-group"><p class="sidebar-heading">我的教學</p>
                <a class="admin-nav-link @(current == "TeacherDashboard" ? "active" : "")" asp-controller="TeacherDashboard" asp-action="Index" aria-current="@(current == "TeacherDashboard" ? "page" : null)"><partial name="_UiIcon" model='"home"' /><span>老師儀表板</span></a>
                <a class="admin-nav-link" asp-controller="TeacherDashboard" asp-action="Index" asp-fragment="my-calendar"><partial name="_UiIcon" model='"calendar"' /><span>我的課表</span></a>
                <a class="admin-nav-link @(current == "TeacherRequests" ? "active" : "")" asp-controller="TeacherRequests" asp-action="Index" aria-current="@(current == "TeacherRequests" ? "page" : null)"><partial name="_UiIcon" model='"file"' /><span>加開／超收申請</span></a>
            </div>
        </nav><div class="sidebar-caption">Enjoy Space · 老師專區</div></div>
    </aside>
    <div class="admin-shell">
        <header class="admin-topbar">
            <a class="es-brand mobile-brand" asp-controller="TeacherDashboard" asp-action="Index"><partial name="_BrandMark" /><span><strong>Enjoy Space</strong><small>米亞工作室</small></span></a>
            <div class="topbar-label">老師專區<span>/</span>@ViewData["Title"]</div>
            <div class="topbar-account"><span class="account-name"><partial name="_UiIcon" model='"user"' />@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit">登出</button></form>
                <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#teacherNavigation" aria-controls="teacherNavigation" aria-label="開啟老師選單"><partial name="_UiIcon" model='"menu"' /></button>
            </div>
        </header>
        <main id="main-content" class="admin-main" tabindex="-1">
            @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
            @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
            @RenderBody()
        </main>
        <footer class="admin-footer"><span>Enjoy Space 米亞工作室 · 老師專區</span><a asp-controller="Home" asp-action="Index">返回入口首頁</a></footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/table-sort.mjs" asp-append-version="true"></script>
    <script src="~/lib/tempus-dominus/popper.min.js" asp-append-version="true"></script>
    <script src="~/lib/tempus-dominus/tempus-dominus.js" asp-append-version="true"></script>
    <script type="module" src="~/js/date-time-picker.mjs" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
