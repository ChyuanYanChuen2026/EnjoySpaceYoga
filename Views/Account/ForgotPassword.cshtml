@model EnjoySpace.Web.Controllers.ForgotPasswordModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "忘記密碼"; }
<h1 id="login-title">設定新密碼</h1>
<p class="login-intro">輸入管理員提供的帳號與登記的 Email，我們會寄送密碼重設驗證信。老師首次設定密碼也使用此流程。</p>
<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="All" class="login-validation" role="alert"></div>
    <div class="login-field">
        <label asp-for="Account" class="form-label">帳號</label>
        <input asp-for="Account" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="100" required />
    </div>
    <div class="login-field">
        <label asp-for="Email" class="form-label">登記的 Email</label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="200" required />
    </div>
    <button class="btn btn-primary login-submit" type="submit">寄送驗證信</button>
</form>
<p class="login-note"><a asp-action="Login">返回登入</a></p>
