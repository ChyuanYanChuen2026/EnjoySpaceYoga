@{ Layout = "_AccountLayout"; ViewData["Title"] = "驗證連結已失效"; }
<h1 id="login-title">驗證連結已失效</h1>
<p class="login-intro" role="alert">此連結無效、已使用或超過 30 分鐘。帳號資料變更也會使舊連結失效，請重新申請驗證信。</p>
<a asp-action="ForgotPassword" class="btn btn-primary login-submit">重新申請驗證信</a>
<p class="login-note"><a asp-action="Login">返回登入</a></p>
