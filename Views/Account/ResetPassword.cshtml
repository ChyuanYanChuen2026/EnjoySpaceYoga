@model EnjoySpace.Web.Controllers.ResetPasswordModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "重設密碼"; }
<h1 id="login-title">重設密碼</h1>
<p class="login-intro">請設定 10～200 字的新密碼，建議使用不易猜測的長密碼。</p>
<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="All" class="login-validation" role="alert"></div>
    <input asp-for="Token" type="hidden" />
    <div class="login-field">
        <label asp-for="Password" class="form-label">新密碼</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" minlength="10" maxlength="200" required />
    </div>
    <div class="login-field">
        <label asp-for="ConfirmPassword" class="form-label">再次輸入新密碼</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" minlength="10" maxlength="200" required />
    </div>
    <button class="btn btn-primary login-submit" type="submit">儲存新密碼</button>
</form>
<p class="login-note"><a asp-action="Login">返回登入</a></p>
