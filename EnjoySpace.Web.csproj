<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b2d7e4d7-fe46-428a-9ff6-ee78add5aed1</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Workflow'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\Entities\Location.cs" />
    <Compile Remove="artifacts\**" />
    <Compile Remove="docs\**" />
    <Compile Remove="Tools\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="docs\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove="docs\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="artifacts\**" />
    <None Remove="docs\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本機連線與開發設定不隨正式網站發佈；正式值由 App Service 提供。 -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Remove="EnjoySpace.Web.csproj.Backup.tmp" />
    <EmbeddedResource Include="Migrations/Sql/ReconcileRecoveredSchema.sql" LogicalName="EnjoySpace.Recovery.compatible-up.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="EnjoySpace.Web.slnx" />
    <None Include="Tests\EmptyDatabaseChecks\EmptyDatabaseChecks.csproj" />
    <None Include="Tests\EnrollmentAmountChecks\EnrollmentAmountChecks.csproj" />
    <None Include="Tests\FirstAdminChecks\FirstAdminChecks.csproj" />
    <None Include="Tests\MigrationDraft\MigrationDraft.csproj" />
    <None Include="Tests\PortalValidationChecks\PortalValidationChecks.csproj" />
    <None Include="Tests\RecoveryMigrationChecks\RecoveryMigrationChecks.csproj" />
    <None Include="Tests\RegistrationWindowChecks\RegistrationWindowChecks.csproj" />
    <None Include="Tests\SchemaInventory\SchemaInventory.csproj" />
    <None Include="Tests\StudentWorkflowChecks\StudentWorkflowChecks.csproj" />
    <None Include="Tests\WorkflowChecks\WorkflowChecks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tests\obj\" />
    <Folder Include="Tests\WorkflowChecks\bin\Debug\net10.0\" />
    <Folder Include="Tests\WorkflowChecks\obj\Debug\net10.0\refint\" />
    <Folder Include="Tests\WorkflowChecks\obj\Debug\net10.0\ref\" />
  </ItemGroup>

</Project>
